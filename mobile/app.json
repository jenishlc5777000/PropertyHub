{
  "expo": {
    "name": "PropertyHub",
    "slug": "propertyhub",
    "scheme": "propertyhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.propertyhub.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PropertyHub uses your location to show properties near you and to pin your listing on the map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.propertyhub.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f2a4a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#059669",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PropertyHub uses your location to show properties near you and to pin your listing on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PropertyHub needs access to your photos so you can add pictures of your property.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
