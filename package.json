{
  "name": "propertyhub",
  "private": true,
  "version": "1.0.0",
  "description": "PropertyHub - real estate platform (API + web + mobile)",
  "workspaces": [
    "shared",
    "backend",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "seed": "npm run seed -w backend",
    "test": "npm test -w backend",
    "build:web": "npm run build -w web",
    "lint": "eslint shared backend web/src mobile/App.js mobile/src",
    "format": "prettier --write \"{shared,backend,web,mobile}/**/*.{js,jsx,json,css,md}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
