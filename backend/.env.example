# ---------- Server ----------
# development | production | test
NODE_ENV=development
PORT=5000
# Public URL of this API (used in emails, invoice links, sitemap)
API_URL=http://localhost:5000
# Public URL of the web app (password reset links, sitemap, CORS)
WEB_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins (web app domains). Mobile apps don't need CORS.
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
# MongoDB Atlas M0 connection string, e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/propertyhub
# Use "memory" to run an in-memory replica set for local development (auto-seeded, data lost on restart).
MONGODB_URI=memory

# ---------- Auth (JWT) ----------
# Generate long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access token lifetime (short) and refresh token lifetime in days
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=30

# ---------- Cloudinary (free tier) ----------
# Leave empty to store uploads on local disk in backend/uploads (dev only; Render's disk is ephemeral).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (Nodemailer SMTP) ----------
# Brevo: smtp-relay.brevo.com:587 with your Brevo login + SMTP key
# Gmail: smtp.gmail.com:465 (SMTP_SECURE=true) with an App Password (needs 2FA)
# Leave SMTP_HOST empty to print emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PropertyHub <no-reply@propertyhub.in>"

# ---------- Razorpay ----------
# Dashboard > Settings > API Keys. Use rzp_test_... keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > secret you set for POST {API_URL}/api/v1/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---------- Business / invoice details ----------
COMPANY_NAME=PropertyHub Technologies Pvt Ltd
COMPANY_ADDRESS=Bengaluru, Karnataka, India
# Your GSTIN (printed on invoices). Leave empty if not registered yet.
COMPANY_GSTIN=
# Default number of free credits for new users (admin can change it in the dashboard)
DEFAULT_FREE_CREDITS=7

# ---------- Abuse protection ----------
# Max unlocks per user per hour, and the daily count that gets flagged as suspicious
UNLOCK_RATE_PER_HOUR=20
UNLOCK_SUSPICIOUS_PER_DAY=30

# ---------- Seed ----------
# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@propertyhub.in
SEED_ADMIN_PASSWORD=Admin@12345

# Optional (dev): use an already-installed mongod for MONGODB_URI=memory instead of auto-downloading
# MONGOMS_SYSTEM_BINARY=C:/path/to/mongod.exe
